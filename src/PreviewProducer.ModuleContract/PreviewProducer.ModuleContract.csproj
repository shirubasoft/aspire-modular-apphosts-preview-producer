<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>Aspire Modular AppHosts preview producer contract</Title>
    <Description>Producer-owned Aspire module contract for the cross-repository preview sample.</Description>
    <PackageId>Shirubasoft.Aspire.ModularAppHosts.PreviewProducer.Contract</PackageId>
    <PackageVersion>2.0.0-preview.1</PackageVersion>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <ModularAppHostsVersion Condition="'$(ModularAppHostsVersion)' == ''">1.1.0</ModularAppHostsVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Shirubasoft.Aspire.ModularAppHosts"
                      Version="$(ModularAppHostsVersion)" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
